{
  "name": "mindmap-ai",
  "version": "0.3.12",
  "private": true,
  "description": "Standalone Obsidian plugin repo for the Mindmap TypeScript-powered workflow.",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "lint:obsidian": "eslint --config eslint.obsidian.config.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./scripts/test-setup.mjs --test $(find src -name '*.test.ts' -print)",
    "test:release": "tsx --import ./scripts/test-setup.mjs --test src/releaseLifecycle.integration.ts",
    "quality:connections": "tsx scripts/evaluate-connection-quality.ts",
    "quality:compare-embeddings": "tsx scripts/compare-embeddings.ts",
    "quality:compare-embeddings:large": "tsx scripts/compare-embeddings.ts --large",
    "quality:verify-migration": "tsx scripts/verify-embedding-migration.ts",
    "check": "npm run lint && npm run lint:obsidian && npm run typecheck && npm test && npm run test:release && npm run build && npm run validate",
    "validate": "node scripts/validate-release.mjs",
    "release:prepare": "npm run test:release && npm run build && npm run validate && node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.1",
    "esbuild": "^0.25.10",
    "eslint": "^10.3.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "motion": "^12.38.0",
    "yaml": "2.9.0"
  }
}
